# Supabase project URL (local: http://127.0.0.1:54321)
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...), replaces the legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Colyseus server endpoint (http(s); the SDK upgrades to ws(s)).
# Leave empty in dev to use <page host>:2567, which also works from a phone on the same Wi-Fi.
VITE_COLYSEUS_URL=
