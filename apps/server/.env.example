# Copy to apps/server/.env for local dev (loaded by @colyseus/tools).

# Port the HTTP + WebSocket server listens on.
PORT=2567

# Supabase project URL (no trailing slash). Access tokens are verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (asymmetric signing keys).
# Local `supabase start`: http://127.0.0.1:54321
SUPABASE_URL=https://your-project.supabase.co

# Comma separated web origins allowed to connect. One leading wildcard label is
# supported (e.g. https://*.vercel.app). Empty = allow any origin (dev only).
ALLOWED_ORIGINS=http://localhost:3000,https://rollbiz.vercel.app

# NODE_ENV=production hides /monitor and the playground.
# NODE_ENV=development
