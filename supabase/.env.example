# Copy to supabase/.env (gitignored). The Supabase CLI loads this file and
# substitutes env(...) references in config.toml on `supabase start`.
# Create an OAuth client (Web application) in Google Cloud console with
# authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
